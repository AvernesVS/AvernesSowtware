+        private static string ResolveWritableLogDirectory(string scriptsDirectory, string dataDirectory)
+        {
+            // Keep the historical Scripts location when it is writable so existing
+            // installations retain their logs. GTA is commonly installed under
+            // Program Files, however, where a non-elevated game process cannot write.
+            string scriptsLogs = Path.Combine(scriptsDirectory, "AvernesSowtware_Logs");
+            if (CanWriteDirectory(scriptsLogs)) return scriptsLogs;
+
+            // ResolveWritableDataDirectory already prefers LocalAppData when the game
+            // directory is protected. Keep logs alongside that per-user data, not in
+            // Program Files, and never let a logging permission failure abort startup.
+            if (!String.IsNullOrEmpty(dataDirectory))
+            {
+                string dataLogs = Path.Combine(dataDirectory, "Logs");
+                if (CanWriteDirectory(dataLogs)) return dataLogs;
+            }
+
+            string localData = Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData);
+            if (!String.IsNullOrEmpty(localData))
+            {
+                string fallback = Path.Combine(localData, "AvernesSowtware", "GTA V Legacy", "Logs");
+                if (CanWriteDirectory(fallback)) return fallback;
+            }
+
+            string documents = Environment.GetFolderPath(Environment.SpecialFolder.MyDocuments);
+            if (!String.IsNullOrEmpty(documents))
+            {
+                string fallback = Path.Combine(documents, "AvernesSowtware", "GTA V Legacy", "Logs");
+                if (CanWriteDirectory(fallback)) return fallback;
+            }
+
+            string temporary = Path.Combine(Path.GetTempPath(), "AvernesSowtware", "GTA V Legacy", "Logs");
+            if (CanWriteDirectory(temporary)) return temporary;
+
+            // The final path is retained for diagnostics. AppendLogFile catches and
+            // records write failures rather than propagating them into the game tick.
+            return scriptsLogs;
+        }
