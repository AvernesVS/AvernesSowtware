+def test_vehicle_deletion_has_no_unconditional_return_after_exit_guard():
+    body = VEHICLE[VEHICLE.index("private void ProcessPendingVehicleDeletion"):VEHICLE.index("private void ToggleSpeedUnit")]
+    guard = "if (ped.IsInVehicle() && IsEntityUsable(ped.CurrentVehicle) && ped.CurrentVehicle.Handle == handle) return;"
+    assert guard in body
+    after_guard = body.split(guard, 1)[1]
+    assert "                return;" not in after_guard.split("try", 1)[0]
+    assert "vehicle.Delete();" in after_guard
+
+
+def test_nitro_never_disables_entity_collision():
+    assert "_nitroCollisionDisabled" not in CORE
+    assert "_nitroCollisionDisabled" not in VEHICLE
+    nitro = VEHICLE[VEHICLE.index("private void ApplyNitroVelocityAssist(int vehicleHandle, float maximumSpeed, float nitroPower)"):VEHICLE.index("private void RestoreNitroSpeedLimit")]
+    assert "SET_ENTITY_COLLISION" not in nitro
