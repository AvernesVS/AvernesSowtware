+        private void RefreshBodyguardsAfterPlayerTeleport(Ped player)
+        {
+            if (_bodyguards.Count == 0 || !IsEntityUsable(player)) return;
+            try
+            {
+                EnsureBodyguardGroup(player);
+                EnsureBodyguardRelationshipGroup(player);
+                _lastBodyguardAimTargetHandle = 0;
+                _lastBodyguardThreatTargetHandle = 0;
+                _lastBodyguardAimTick = 0;
+                _lastBodyguardFollowTick = 0;
+                _bodyguardPlayerVehicleHandle = 0;
+                for (int i = _bodyguards.Count - 1; i >= 0; i--)
+                {
+                    int guard = _bodyguards[i];
+                    if (!IsLivingBodyguardHandle(guard))
+                    {
+                        _bodyguards.RemoveAt(i);
+                        RetireDeadBodyguardHandle(guard, "invalid after player teleport");
+                        continue;
+                    }
+                    _bodyguardBoardingVehicleHandles.Remove(guard);
+                    _bodyguardBoardingDeadlinesUtc.Remove(guard);
+                    _bodyguardBoardingEnterAtUtc.Remove(guard);
+                    _bodyguardBoardingSeats.Remove(guard);
+                    Function.Call(Hash.CLEAR_PED_TASKS, guard);
+                    IssueBodyguardFollowTask(guard, player.Handle);
+                }
+            }
+            catch (Exception ex) { LogException("RefreshBodyguardsAfterPlayerTeleport", ex); }
+        }
+
