+        private void RefreshBodyguardsAfterPlayerTeleport(Ped player)
+        {
+            if (!IsEntityUsable(player) || _bodyguards.Count == 0) return;
+            try
+            {
+                EnsureBodyguardGroup(player);
+                EnsureBodyguardRelationshipGroup(player);
+                _bodyguardPlayerVehicleHandle = 0;
+                _lastBodyguardAimTargetHandle = 0;
+                _lastBodyguardAimTick = 0;
+                _lastBodyguardThreatTargetHandle = 0;
+                _lastBodyguardThreatScanUtc = DateTime.MinValue;
+
+                for (int i = _bodyguards.Count - 1; i >= 0; i--)
+                {
+                    int handle = _bodyguards[i];
+                    try
+                    {
+                        if (!IsLivingBodyguardHandle(handle))
+                        {
+                            _bodyguards.RemoveAt(i);
+                            QueueBodyguardDismissal(handle);
+                            continue;
+                        }
+
+                        _bodyguardBoardingVehicleHandles.Remove(handle);
+                        _bodyguardBoardingDeadlinesUtc.Remove(handle);
+                        _bodyguardBoardingEnterAtUtc.Remove(handle);
+                        _bodyguardBoardingSeats.Remove(handle);
+                        Function.Call(Hash.CLEAR_PED_TASKS, handle);
+                        Function.Call((Hash)0x9F3480FE65DB31B5UL, handle, _bodyguardGroupId); // SET_PED_AS_GROUP_MEMBER
+                        Function.Call((Hash)0x3DBFC55D5C9BB447UL, handle, true); // SET_PED_NEVER_LEAVES_GROUP
+                        Function.Call((Hash)0x2E2F4240B3F24647UL, handle, true); // SET_PED_CAN_TELEPORT_TO_GROUP_LEADER
+                        IssueBodyguardFollowTask(handle, player.Handle);
+                    }
+                    catch (Exception guardException)
+                    {
+                        LogException("Refresh bodyguard after teleport " + handle, guardException);
+                    }
+                }
+                _lastBodyguardFollowTick = 0;
+                Log("Bodyguards refreshed after player teleport.");
+            }
+            catch (Exception ex)
+            {
+                LogException("RefreshBodyguardsAfterPlayerTeleport", ex);
+            }
+        }
+
