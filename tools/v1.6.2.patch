diff --git a/tests/test_1_6_2_regressions.py b/tests/test_1_6_2_regressions.py
new file mode 100644
index 0000000..6fdf0f2
--- /dev/null
+++ b/tests/test_1_6_2_regressions.py
@@ -0,0 +1,23 @@
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+
+def read(rel):
+    return (ROOT / rel).read_text(encoding="utf-8-sig")
+
+def test_toggle_entries_are_marked_as_toggles():
+    source = read("src/Core/AvernesSowtwareScript.cs")
+    start = source.index("private MenuEntry ToggleEntry(")
+    end = source.index("\n        }", start)
+    assert "}, true);" in source[start:end]
+
+def test_nitro_top_speed_headroom_is_800():
+    source = read("src/Managers/VehicleSystems.cs")
+    assert "handle, 800.0f); // MODIFY_VEHICLE_TOP_SPEED" in source
+
+def test_nitro_collision_is_restored_when_speed_drops_or_nitro_stops():
+    source = read("src/Managers/VehicleSystems.cs")
+    assert "forwardSpeed > 100.0f && !_nitroCollisionDisabled" in source
+    assert "forwardSpeed <= 100.0f && _nitroCollisionDisabled" in source
+    assert "if (restoreCollision)" in source
+    assert "SET_ENTITY_COLLISION" in source
